# Kế hoạch cụm k3s + ARC trên Proxmox, dùng chung cho pve-discovery.sh và pve-create-vms.sh.
# Copy lên Proxmox host thành /root/k3s-plan.env, sửa nếu cần, rồi nạp trước khi chạy script:
#   set -a; source /root/k3s-plan.env; set +a
#   bash /root/pve-discovery.sh
#   bash /root/pve-create-vms.sh

BRIDGE=vmbr1                 # bridge nội bộ + NAT qua host, không tốn IP LAN
STORAGE=local-lvm2           # LVM thick, còn ~348 GB
SNIPPET_STORAGE=local
# GATEWAY / PREFIX để trống: tự lấy 192.168.8.1/22 từ vmbr1

# IP tĩnh phải nằm NGOÀI dải DHCP 192.168.8.10–192.168.11.254 (dhcpd trên host)
TEMPLATE_ID=9000
SERVER_ID=201
SERVER_IP=192.168.8.2
WORKER_IDS="211 212"
WORKER_IPS="192.168.8.3 192.168.8.4"
MIRROR_ID=220
MIRROR_IP=192.168.8.5

SERVER_CORES=2
SERVER_MEM_GB=4
SERVER_DISK_GB=30
WORKER_CORES=8
WORKER_MEM_GB=16
WORKER_DISK_GB=100
MIRROR_CORES=2
MIRROR_MEM_GB=4
MIRROR_DISK_GB=50

CPU_SAMPLE_SEC=30
