# ============================================================
# GitHub Runner LXC Monitor - Environment Variables
# Copy file này thành .env và điền giá trị thực
# cp .env.example .env && nano .env
# ============================================================

# --- GitHub Configuration ---
# Personal Access Token với quyền admin:org
GITHUB_TOKEN="ghp_your_token_here"

# Tên tổ chức GitHub
ORGNAME="Gravity-Global"

# Nhóm runner và labels
RUNNER_GROUP="VN-Team"
RUNNER_LABELS="vn-gaqc-docker,test-setup"

# --- LXC Runner Configuration ---
# Số lượng LXC runner tối đa được phép tồn tại
# Script sẽ không tạo mới nếu số lượng hiện tại đã đạt giới hạn này
LXC_COUNT=35

# ID container template dùng để clone (phải tồn tại trên Proxmox)
# Tạo template bằng lxc_create_github_actions_runner.master.sh trước
SOURCE_CONTAINER_ID=100

# Danh sách LXC ID cần monitor, phân cách bằng dấu phẩy.
# Để trống hoặc "auto" để tự động tìm theo pattern tên "github-runner-*"
# Ví dụ: LXC_IDS="100,101,102"
LXC_IDS="auto"

# Pattern tên container để tự động tìm (dùng khi LXC_IDS=auto)
LXC_NAME_PATTERN="github-runner-"

# --- Disk Threshold ---
# Ngưỡng disk usage (%) để kích hoạt tái tạo container
# Mặc định: 85 (khi disk dùng >= 85% sẽ xóa và tạo lại)
DISK_THRESHOLD=85

# --- Maintenance Window ---
# Chỉ rebuild container trong khoảng giờ này (giờ thấp điểm, ít job chạy nhất)
# Ngoài window: phát hiện disk đầy nhưng chỉ cảnh báo, không rebuild
# Đơn vị: giờ (0–23), timer check mỗi 4h lúc: 1h, 5h, 9h, 13h, 17h, 21h
MAINTENANCE_START=1   # bắt đầu 1:00 AM
MAINTENANCE_END=6     # kết thúc 6:00 AM (không bao gồm)

# --- LXC Template & Runner ---
# URL template Ubuntu cho LXC
TEMPL_URL="http://download.proxmox.com/images/system/ubuntu-22.04-standard_22.04-1_amd64.tar.zst"

# URL GitHub Actions Runner (cập nhật version mới nhất nếu cần)
GITHUB_RUNNER_URL="https://github.com/actions/runner/releases/download/v2.334.0/actions-runner-linux-x64-2.334.0.tar.gz"

# Kích thước ổ đĩa container
PCTSIZE="50G"

# Số CPU cores và RAM (MB) cho container
PCT_CORES=5
PCT_MEMORY=32768
PCT_SWAP=32768

# Storage Proxmox
PCT_STORAGE="local-lvm2"

# Bridge network
PCT_BRIDGE="vmbr1"

# --- Logging ---
# Thư mục lưu log
LOG_DIR="/var/log/lxc-monitor"

# Số ngày giữ log cũ
LOG_RETAIN_DAYS=30

# --- Notification (tuỳ chọn) ---
# Gửi thông báo Telegram khi tái tạo container (để trống để bỏ qua)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Gửi thông báo Slack webhook (để trống để bỏ qua)
SLACK_WEBHOOK_URL=""
