# /etc/lxc-runner/lxc-runner.env — cấu hình lxc-runner (chmod 600, chứa token)
# Biến môi trường khi chạy lệnh sẽ ghi đè giá trị ở đây.

# ── GitHub ─────────────────────────────────────────────────────────────────
# PAT classic, quyền admin:org (đăng ký/gỡ runner, sửa labels)
GITHUB_TOKEN=
ORGNAME=Gravity-Global
RUNNER_GROUP=VN-Team
RUNNER_LABELS=vn-gaqc-docker,test-setup
GITHUB_RUNNER_URL=https://github.com/actions/runner/releases/download/v2.338.0/actions-runner-linux-x64-2.338.0.tar.gz

# ── Template / container ──────────────────────────────────────────────────
# ID container template (in ra cuối `lxc-runner template`)
SOURCE_CONTAINER_ID=100
TEMPL_URL=http://download.proxmox.com/images/system/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
PCTSIZE=25G
PCT_CORES=3
PCT_MEMORY=16384
PCT_SWAP=4096
PCT_STORAGE=local-lvm2
PCT_BRIDGE=vmbr1

# ── Recycle ────────────────────────────────────────────────────────────────
# Chạy thử: chỉ log, không thay đổi gì. Đổi thành 0 khi đã kiểm tra log ổn.
DRY_RUN=1
# Disk >= ngưỡng này thì xử lý (%)
DISK_THRESHOLD=90
# Dọn trước; sau khi dọn < mức này thì không rebuild (%)
CLEANUP=1
CLEAN_TARGET=80
# Số runner rebuild tối đa mỗi lượt timer
MAX_REBUILDS_PER_RUN=1
# Số runner tối đa. Runner disk đầy + đang rảnh:
#   tổng > MAX_RUNNERS  → xóa, không clone thêm
#   tổng <= MAX_RUNNERS → dọn, vẫn đầy thì xóa + clone mới
# Rỗng = không giới hạn (luôn clone thay thế).
MAX_RUNNERS=
# Khung giờ cho phép rebuild, vd 1-6 (01:00–06:00). Rỗng = bất kỳ lúc nào.
REBUILD_HOURS=
# Chỉ xử lý các ID này, vd 101,102. Rỗng = mọi container khớp LXC_NAME_PATTERN.
LXC_IDS=
LXC_NAME_PATTERN=^github-runner-
# Chừa thêm trên storage khi quyết định clone trước/xóa sau (GB)
STORAGE_MARGIN_GB=10

# ── Thông báo (tùy chọn) ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
