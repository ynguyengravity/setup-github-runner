[Unit]
Description=LXC GitHub Runner Disk Monitor - Chạy định kỳ
Documentation=https://github.com/ynguyengravity/setup-github-runner

[Timer]
# Check disk mỗi 4 giờ để phát hiện sớm
# Script tự quyết định có rebuild hay không dựa vào maintenance window
OnCalendar=*-*-* 01,05,09,13,17,21:00:00

# Không cần random delay — service đơn lẻ trên 1 host, không có tranh chấp
RandomizedDelaySec=0

# Chạy lại nếu lần trước bị bỏ lỡ (Proxmox reboot, v.v.)
Persistent=true

[Install]
WantedBy=timers.target
